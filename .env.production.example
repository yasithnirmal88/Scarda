# ===========================================================================
# Scarda Production Environment
# ===========================================================================
# Copy this file to .env.production and fill in real values:
#
#   cp .env.production.example .env.production
#
# Then start the stack:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# ===========================================================================

# --- Domain (REQUIRED for HTTPS) -------------------------------------------
# The domain pointing to your VM's public IP.
# Caddy will automatically obtain Let's Encrypt certificates.
# Use a real domain for production HTTPS.
DOMAIN=scarda.example.com

# --- Database ---------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_strong_password_here
DB_NAME=solar_aim

# --- Security (REQUIRED) ----------------------------------------------------
# Generate a strong secret: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# JWT token expiry (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — set to your frontend domain in production
# Comma-separated list of allowed origins
CORS_ORIGINS=https://scarda.example.com

# --- Huawei Provider (Mock for now) ----------------------------------------
# Currently points to the mock service inside Docker network.
# When real credentials arrive:
#   1. Set HUAWEI_BASE_URL to the real Northbound API URL
#   2. Set real HUAWEI_USERNAME / HUAWEI_PASSWORD / HUAWEI_PLANT_CODE
#   3. Remove the "mock" service from docker-compose.prod.yml
HUAWEI_BASE_URL=http://mock:8001
HUAWEI_USERNAME=huawei
HUAWEI_PASSWORD=huawei
HUAWEI_PLANT_CODE=sim-plant-001

# --- Scheduler --------------------------------------------------------------
# Enable the live data polling scheduler
SCHEDULER_ENABLED=true

# How often to fetch live readings (minutes)
# 10 = every 10 minutes (matches the datalogger assumption)
SCHEDULER_INTERVAL_MINUTES=10

# How often to run alert processing (minutes)
SCHEDULER_ALERT_INTERVAL_MINUTES=1

# --- Historical Data --------------------------------------------------------
# Lookback window for the similarity algorithm (days)
HISTORICAL_LOOKBACK_DAYS=90

# Run 90-day backfill on startup (set to false after initial backfill)
# Note: internally this is THRESHOLD_BACKFILL_ON_STARTUP — the compose file
# handles the mapping for you.
HISTORICAL_BACKFILL_ON_STARTUP=true

# --- Mock FusionSolar -------------------------------------------------------
# Scenario: healthy | cloudy | degraded_string | night
SIM_SCENARIO=healthy

# Simulation interval in seconds (600 = 10 minutes)
SIM_INTERVAL=600

# --- App --------------------------------------------------------------------
APP_NAME=Scarda
