# ===========================================================================
# Caddy reverse proxy — automatic HTTPS via Let's Encrypt
#
# Caddy automatically obtains and renews TLS certificates for your domain.
# No manual cert management needed.
# ===========================================================================

{
	# Production: uncomment for stricter security
	# email you@example.com
}

# ===========================================================================
# Caddy configuration
#
# LOCAL TESTING (no domain):
#   Comment out the {$DOMAIN} block below and uncomment the :80 block.
#
# PRODUCTION (with domain):
#   Keep the {$DOMAIN} block. Caddy obtains Let's Encrypt certs automatically.
#   Set DOMAIN in .env.production to your real domain.
# ===========================================================================

# --- PRODUCTION: automatic HTTPS via Let's Encrypt ---
{$DOMAIN} {
	encode gzip zstd

	# API + WebSocket → backend
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Everything else → frontend (nginx serving the SPA)
	reverse_proxy frontend:80
}

# HTTP → HTTPS redirect (Caddy does this automatically, but explicit fallback)
http://{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# --- LOCAL TESTING: uncomment to test without a domain ---
