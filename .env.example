APP_NAME=Solar AIM
DEBUG=false
PROVIDER_TYPE=fake

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/solar_aim

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_SIMULATOR_INTERVAL_MINUTES=10
SCHEDULER_ALERT_INTERVAL_MINUTES=10
SCHEDULER_CLEANUP_INTERVAL_HOURS=24
SCHEDULER_STATS_INTERVAL_MINUTES=15

# Alert Thresholds
THRESHOLD_CURRENT_THRESHOLD_PCT=30.0
THRESHOLD_VOLTAGE_THRESHOLD_PCT=15.0
THRESHOLD_POWER_THRESHOLD_PCT=30.0
THRESHOLD_CONFIRMATION_CYCLES=2
THRESHOLD_MAX_CONFIRMATION_DELAY_MINUTES=20
THRESHOLD_SEVERITY_WARNING_THRESHOLD=25.0
THRESHOLD_SEVERITY_CRITICAL_THRESHOLD=60.0
THRESHOLD_ENABLE_RECOMMENDATIONS=true
THRESHOLD_OFFLINE_VOLTAGE_THRESHOLD=10.0
THRESHOLD_OFFLINE_CURRENT_THRESHOLD=0.5
THRESHOLD_COMMUNICATION_FAILURE_WINDOW_MINUTES=30
THRESHOLD_BASELINE_CURRENT=10.0
THRESHOLD_BASELINE_VOLTAGE=820.0
THRESHOLD_BASELINE_POWER=8200.0

# Logging
LOGGING_LEVEL=INFO
LOGGING_UVICORN_ACCESS_LEVEL=WARNING